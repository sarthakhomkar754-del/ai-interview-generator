{
	"info": {
		"_postman_id": "interview-generator-postman-collection",
		"name": "AI Interview Question Generator API",
		"description": "Complete Postman collection for testing the Spring Boot REST API endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/auth/register",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@interview.com\",\n  \"password\": \"user123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Login Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@interview.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Questions & Generator",
			"item": [
				{
					"name": "Generate Questions",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"technologyId\": 1,\n  \"jobRoleId\": 1,\n  \"experienceLevelId\": 2,\n  \"count\": 5\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/questions/generate",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "questions", "generate"]
						}
					}
				},
				{
					"name": "Filter Questions",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8080/api/questions?search=HashMap",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "questions"],
							"query": [
								{
									"key": "search",
									"value": "HashMap"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Favorites & History",
			"item": [
				{
					"name": "Get Favorites",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8080/api/favorites",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "favorites"]
						}
					}
				},
				{
					"name": "Get User History",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "http://localhost:8080/api/history",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "history"]
						}
					}
				}
			]
		}
	]
